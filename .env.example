# Copy to .env (gitignored) for local runs. On GitHub, add these as repository secrets.

# From your address page: https://www.northyorks.gov.uk/bin-calendar/<AREA>/results/<UPRN>
BIN_AREA=Harrogate
BIN_UPRN=000000000000

# Google Calendar > Settings > (your calendar) > Integrate calendar > Calendar ID
GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxx@group.calendar.google.com

# Optional: reminder minutes before midnight on collection day (300 = 7pm the evening before).
# Only used with OAuth login; with a service account set the calendar's default notifications.
# BIN_REMINDER_MINUTES=300

# Google auth: either put the service-account key file at ./service_account.json,
# or (as on GitHub) put its whole JSON contents in GOOGLE_SERVICE_ACCOUNT_JSON.
